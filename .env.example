# Copy to .env for local development. Never commit .env.
# In production the platform sets the settings, the Discord token comes from /run/secrets/app.json
# (key DISCORD_TOKEN), and database URLs come from secret files (*_FILE).

# Bot
# Development only: the token. In production it is read from /run/secrets/app.json, never the environment.
DISCORD_TOKEN=
# The Discord application's ID. A placeholder here, so the image starts in the contract test.
DISCORD_APPLICATION_ID=000000000000000000
# Optional: another path for the secrets file. Default: /run/secrets/app.json, if it exists.
APP_SECRETS_FILE=
# Optional: the folder holding the art (arachne-*.png, emblems/*.svg and so on). Default: assets/ at the repo root. The app runs without it.
ASSETS_DIR=
# Optional: registers commands instantly in one test server instead of globally.
DISCORD_DEV_GUILD_ID=

# Database. Each process connects with its own role. In production each URL is a secret file:
# the file holding the process's own URL ...
DATABASE_URL_FILE=
# ... and the plain URL for development, used when DATABASE_URL_FILE is empty.
DATABASE_URL=postgres://scrimbot:scrimbot@127.0.0.1:5432/scrimbot
# Bot only: files holding the owner URL (to migrate) and the web role's URL (to set its password).
# Leave empty in development, where `pnpm dev` migrates.
DATABASE_OWNER_URL_FILE=
DATABASE_WEB_URL_FILE=

# Web
PORT=3000
# Where the roster page is opened. Roster links in Discord are built from this: in dev the Vite
# page (5173), in production the app's public address. Use your machine's address if you open
# the link from another device.
PUBLIC_URL=http://localhost:5173

LOG_LEVEL=info

# Optional: the Python interpreter. By default python/.venv if it exists, otherwise python3.
PYTHON_BIN=
